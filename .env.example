## Phoenix Legal (curso) - Ejemplo de configuración (SIN secretos)
#
# Copia este archivo a `.env` y ajusta lo necesario.
#
# Camino oficial:
# - API: uvicorn app.main:app --port 8000
# - UI:  streamlit run app/ui/streamlit_mvp.py
#

# Entorno
ENVIRONMENT=development
DEBUG=0

# UI -> API (OBLIGATORIO)
PHOENIX_API_BASE_URL=http://localhost:8000

# Base de datos (por defecto: sqlite local en runtime/)
DATABASE_URL=sqlite:///./runtime/db/phoenix_legal.db

# LLM
# Nota: el endpoint de informe económico está en modo estricto (requiere OPENAI_API_KEY).
OPENAI_API_KEY=
LLM_ENABLED=1

# Email (Gmail SMTP) - usar App Password (no contraseña normal)
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USE_TLS=1
SMTP_USER=
SMTP_PASSWORD=
MAIL_FROM=

# Firma del abogado (para que el PDF salga “de despacho”)
LAWYER_NAME=
LAWYER_COLLEGIATE_NUMBER=
LAWYER_BAR_ASSOCIATION=
LAW_FIRM=
LAWYER_OFFICE_CITY=
# Requisito PRD para exportación a cliente (YYYY-MM-DD)
LAWYER_SIGNATURE_DATE=

# Logging
LOG_LEVEL=INFO
LOG_FORMAT=text
