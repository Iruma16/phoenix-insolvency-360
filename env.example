# Phoenix Legal - ejemplo de configuración
# Copia a `.env` y ajusta según tu entorno.
#
# Nota:
# - En CI podemos dejar `OPENAI_API_KEY` vacío y/o `LLM_ENABLED=false`.
# - SQLite por defecto, relativo a la raíz del repo.

ENVIRONMENT=development
DEBUG=false

# API base (usada principalmente por la UI Streamlit)
PHOENIX_API_BASE_URL=http://localhost:8000

# DB (por defecto SQLite local)
DATABASE_URL=sqlite:///./runtime/db/phoenix_legal.db

# Seguridad (en producción debe cambiarse)
JWT_SECRET_KEY=change_this_secret_key_in_production
JWT_ALGORITHM=HS256

# LLM (opcional)
OPENAI_API_KEY=
LLM_ENABLED=false

